<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121820"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KALIBRASI TOMBOL PTT FISIK"
        android:textColor="#00FFA3"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tekan tombol samping PTT HT..."
        android:textColor="#94A3B8"
        android:textSize="8sp" />

    <TextView
        android:id="@+id/tvDetectedKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#1E293B"
        android:gravity="center"
        android:padding="6dp"
        android:text="TEKAN TOMBOL..."
        android:textColor="#38BDF8"
        android:textSize="9sp"
        android:textStyle="bold" />

    <!-- Pilihan Cepat Tombol CARAKA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPreset290"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:text="CARAKA (290)"
            android:textColor="#00FFA3"
            android:textSize="7.5sp" />

        <Button
            android:id="@+id/btnPreset291"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:text="CARAKA (291)"
            android:textColor="#00FFA3"
            android:textSize="7.5sp" />

        <Button
            android:id="@+id/btnPreset216"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:text="SIDE (216)"
            android:textColor="#38BDF8"
            android:textSize="7.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text=""
        android:textColor="#EF4444"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResetPtt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:text="RESET DEFAULT"
            android:textColor="#CBD5E1"
            android:textSize="8sp" />

        <Button
            android:id="@+id/btnSavePtt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#059669"
            android:text="SIMPAN"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
