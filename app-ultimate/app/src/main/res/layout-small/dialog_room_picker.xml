<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvRoomPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PILIH ROOM"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshRooms"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#1E293B"
            android:paddingHorizontal="8dp"
            android:text="🔄 REFRESH"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCloseRoomPicker"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="#1E293B"
            android:paddingHorizontal="8dp"
            android:text="✕"
            android:textColor="#F43F5E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- Current Room Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B132B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/tvCurrentRoomBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● Sedang di: LOBBY"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search / Filter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <EditText
            android:id="@+id/etSearchRoom"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#1E293B"
            android:hint="🔍 Cari nama room..."
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Room List Scroll Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <LinearLayout
            android:id="@+id/layoutRoomList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dynamic Room Items Injected Here -->

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- Manual Room Direct Join Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etManualRoom"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:hint="Ketik nama room..."
            android:inputType="text"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:textColor="#FBBF24"
            android:textColorHint="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnJoinManualRoom"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="#0284C7"
            android:paddingHorizontal="12dp"
            android:text="MASUK"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
