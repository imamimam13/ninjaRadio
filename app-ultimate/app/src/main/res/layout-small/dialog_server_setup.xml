<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PENGATURAN SERVER"
            android:textColor="#00FFA3"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 LAYAR PENUH"
            android:textColor="#64748B"
            android:textSize="7sp" />
    </LinearLayout>

    <!-- Scrollable Form Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Selector -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILIH PROFIL SERVER:"
                android:textColor="#38BDF8"
                android:textSize="7.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spnProfiles"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="#1E293B" />

                <Button
                    android:id="@+id/btnNewProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:background="#0284C7"
                    android:paddingHorizontal="4dp"
                    android:text="+ BARU"
                    android:textColor="#FFFFFF"
                    android:textSize="7.5sp" />

                <Button
                    android:id="@+id/btnDeleteProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="#EF4444"
                    android:paddingHorizontal="4dp"
                    android:text="HAPUS"
                    android:textColor="#FFFFFF"
                    android:textSize="7.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="NAMA PROFIL:"
                android:textColor="#94A3B8"
                android:textSize="7.5sp" />

            <EditText
                android:id="@+id/etProfileName"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:background="#1E293B"
                android:hint="Contoh: DMR Bridi"
                android:inputType="text"
                android:paddingHorizontal="4dp"
                android:singleLine="true"
                android:textColor="#38BDF8"
                android:textColorHint="#64748B"
                android:textSize="8sp" />

            <!-- Protocol Type & Port -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PROTOKOL:"
                        android:textColor="#94A3B8"
                        android:textSize="7.5sp" />

                    <Spinner
                        android:id="@+id/spnServerType"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:background="#1E293B" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PORT:"
                        android:textColor="#94A3B8"
                        android:textSize="7.5sp" />

                    <EditText
                        android:id="@+id/etPort"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:background="#1E293B"
                        android:hint="Port"
                        android:inputType="number"
                        android:padding="3dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Host / IP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="HOST / IP SERVER:"
                android:textColor="#94A3B8"
                android:textSize="7.5sp" />

            <EditText
                android:id="@+id/etHost"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginTop="1dp"
                android:background="#1E293B"
                android:hint="Host / IP"
                android:inputType="textUri"
                android:padding="3dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="9.5sp" />

            <!-- Callsign & Password -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CALLSIGN:"
                        android:textColor="#94A3B8"
                        android:textSize="7.5sp" />

                    <EditText
                        android:id="@+id/etCallsign"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:background="#1E293B"
                        android:hint="Callsign"
                        android:inputType="textCapCharacters"
                        android:padding="3dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD:"
                        android:textColor="#94A3B8"
                        android:textSize="7.5sp" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:background="#1E293B"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:padding="3dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Default TG / Room & DMR ID -->
            <LinearLayout
                android:id="@+id/rowTgDmr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TG / ROOM (Angka / Nama):"
                        android:textColor="#94A3B8"
                        android:textSize="7.5sp" />

                    <EditText
                        android:id="@+id/etTalkgroup"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:background="#1E293B"
                        android:hint="TG atau Nama Room"
                        android:inputType="text"
                        android:padding="3dp"
                        android:singleLine="true"
                        android:textColor="#FBBF24"
                        android:textColorHint="#64748B"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerDmrId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="DMR ID:"
                        android:textColor="#94A3B8"
                        android:textSize="7.5sp" />

                    <EditText
                        android:id="@+id/etDmrId"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:background="#1E293B"
                        android:hint="DMR ID"
                        android:inputType="number"
                        android:padding="3dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar (Fixed height, always visible at bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="#334155"
            android:text="BATAL"
            android:textColor="#94A3B8"
            android:textSize="8sp" />

        <Button
            android:id="@+id/btnSaveProfileOnly"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1.2"
            android:background="#0284C7"
            android:text="SIMPAN"
            android:textColor="#FFFFFF"
            android:textSize="8sp" />

        <Button
            android:id="@+id/btnSaveConnect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1.5"
            android:background="#059669"
            android:text="KONEK"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
