<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Top Tactical Status Strip (Height 17dp) -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="17dp"
        android:background="@drawable/top_bar_bg"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_ninja_logo" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="NINJA RT(X)"
            android:textColor="#38BDF8"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSystemInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23:10 | 95%"
            android:textColor="#94A3B8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/badge_status_offline"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="● OFFLINE"
            android:textColor="#94A3B8"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Quick Server Carousel (Height 22dp, matches bottom buttons) -->
    <LinearLayout
        android:id="@+id/layoutServerRow"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="1dp"
        android:background="#0F192D"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <Button
            android:id="@+id/btnServerPrev"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_dpad"
            android:focusable="false"
            android:text="◀"
            android:textColor="#38BDF8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvServerBadge"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="2dp"
            android:layout_weight="1"
            android:background="@drawable/badge_pill"
            android:gravity="center"
            android:text="⚡ SVXLINK • OPUS 16k"
            android:textColor="#00F0FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnServerNext"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_dpad"
            android:focusable="false"
            android:text="▶"
            android:textColor="#38BDF8"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Row 3: Talkgroup Channel Bar with Quick Switch (Height 22dp, matches bottom buttons) -->
    <LinearLayout
        android:id="@+id/layoutTgBar"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="1dp"
        android:background="@drawable/card_zone_a"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="beforeDescendants"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <Button
            android:id="@+id/btnTgPrev"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:background="@drawable/btn_dpad"
            android:focusable="false"
            android:text="◀"
            android:textColor="#FBBF24"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvTg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="TG 1025"
            android:textColor="#FBBF24"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_ts_amber"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="TS 2"
            android:textColor="#FBBF24"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTgNext"
            android:layout_width="18dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:background="@drawable/btn_dpad"
            android:focusable="false"
            android:text="▶"
            android:textColor="#FBBF24"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Row 4: Large Caller & Cockpit Card (Expands to fill screen) -->
    <LinearLayout
        android:id="@+id/layoutCallerCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:background="@drawable/card_zone_caller"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <!-- Left Vertical Status Accent Bar -->
        <View
            android:id="@+id/viewCallerAccent"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:background="#00F0FF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTalker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="STANDBY (IDLE)"
                android:textColor="#00F0FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTelemetry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Node: 1022057 • Ping: 18ms"
                    android:textColor="#94A3B8"
                    android:textSize="8.5sp" />

                <TextView
                    android:id="@+id/tvQsoTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#FFB800"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Row 5: Tactical S-Meter Level Bar (Height 14dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="2dp">

        <ProgressBar
            android:id="@+id/pbLevel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_vu" />

        <TextView
            android:id="@+id/tvSmeterScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="S1   S3   S5   S7   S9   +20  +40"
            android:textColor="#475569"
            android:textSize="7sp" />
    </LinearLayout>

    <!-- Row 6: Bottom Navigation Bar with Curved Pill Buttons (Height 23dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="23dp"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="1dp">

        <Button
            android:id="@+id/btnNavRadio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/badge_pill"
            android:text="RADIO"
            android:textColor="#00FFA3"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavServer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/btn_key_ch"
            android:text="SERVER"
            android:textColor="#CBD5E1"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavTg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/badge_ts_amber"
            android:text="TG / CH"
            android:textColor="#FBBF24"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_key_menu"
            android:text="PTT"
            android:textColor="#38BDF8"
            android:textSize="8.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
