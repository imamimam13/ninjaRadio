<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PENGATURAN TG / ROOM"
            android:textColor="#FBBF24"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DINAMIS"
            android:textColor="#64748B"
            android:textSize="7sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Input Fields Row: TG/Room and Name -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NOMOR TG / NAMA ROOM:"
                        android:textColor="#94A3B8"
                        android:textSize="7.5sp" />

                    <EditText
                        android:id="@+id/etTargetTg"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:background="#1E293B"
                        android:hint="Contoh: 1025 atau Lobby"
                        android:inputType="text"
                        android:padding="3dp"
                        android:singleLine="true"
                        android:textColor="#FBBF24"
                        android:textColorHint="#64748B"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NAMA / LABEL (BEBAS):"
                        android:textColor="#94A3B8"
                        android:textSize="7.5sp" />

                    <EditText
                        android:id="@+id/etTargetName"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:layout_marginTop="1dp"
                        android:background="#1E293B"
                        android:hint="Contoh: NUSANTARA"
                        android:inputType="textCapCharacters"
                        android:padding="3dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Buttons Row: Save and Apply -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTgCancel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="#334155"
                    android:text="BATAL"
                    android:textColor="#94A3B8"
                    android:textSize="8sp" />

                <Button
                    android:id="@+id/btnTgSaveOnly"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1.3"
                    android:background="#0284C7"
                    android:text="+ SIMPAN"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTgSaveApply"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1.4"
                    android:background="#059669"
                    android:text="PILIH &amp; PAKAI"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Saved List Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="DAFTAR TERSIMPAN (Tekan untuk Pilih):"
                android:textColor="#38BDF8"
                android:textSize="7.5sp"
                android:textStyle="bold" />

            <!-- Dynamic Saved List Container -->
            <LinearLayout
                android:id="@+id/layoutSavedTgList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
