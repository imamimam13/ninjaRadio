<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#121820"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KALIBRASI TOMBOL PTT FISIK"
        android:textColor="#00E599"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tekan tombol fisik yang ingin Anda gunakan sebagai PTT (misal: tombol samping / Side Key)."
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvDetectedKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="#1E293B"
        android:gravity="center"
        android:padding="14dp"
        android:text="MENUNGGU TEKANAN TOMBOL..."
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Pilihan Cepat Tombol CARAKA / PoC -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ATAU PILIH LANGSUNG TOMBOL CARAKA:"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPreset290"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:text="CARAKA (290)"
            android:textColor="#00FFA3"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreset291"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:text="CARAKA (291)"
            android:textColor="#00FFA3"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPreset216"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:text="SIDE (216)"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text=""
        android:textColor="#EF4444"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResetPtt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:text="RESET DEFAULT"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSavePtt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#059669"
            android:enabled="false"
            android:text="SIMPAN TOMBOL"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
