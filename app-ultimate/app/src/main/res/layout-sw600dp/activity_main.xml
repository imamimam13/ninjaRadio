<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E14"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Left Pane: Server Profiles & Audio Setup (300dp) -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="#121820"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivHeaderLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_ninja_logo" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="NINJA RT(X)"
                android:textColor="#00E599"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="SVXLINK • OPUS 16kHz"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="svx.ninjaradio.id:5300 (Connected)"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#1E293B" />

        <!-- Control Buttons -->
        <Button
            android:id="@+id/btnSwitchServer"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:background="#1E293B"
            android:text="PILIH / EDIT SERVER"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCalibratePtt"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:background="#1E293B"
            android:text="KALIBRASI TOMBOL PTT"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnAudioRoute"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#1E293B"
            android:text="AUDIO ROUTING"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPttIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#064E3B"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="[PTT: SIDE KEY (216)]"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Pane: Telemetry & Transmission Panel -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Active Talker Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121820"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvTalker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="STANDBY (IDLE)"
                android:textColor="#00E599"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTalkerDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="TG 1025 • NUSANTARA | Node: 1022057"
                android:textColor="#F8FAFC"
                android:textSize="12sp" />

            <!-- S-Meter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSmeterLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SIGNAL S-METER"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLevelDbfs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S9+20 (-14 dBFS)"
                        android:textColor="#00E599"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbLevel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@android:drawable/progress_horizontal" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="S1    S3    S5    S7    S9    +20   +40"
                    android:textColor="#475569"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Network Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTelemetry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ping: 18ms | Loss: 0% | Jitter: 2ms"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvQsoTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QSO: 00:00"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick TG Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTg1025"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#047857"
                android:text="TG 1025"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTg91"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:text="TG 91"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTg38"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:text="TG 38"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTg510"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:text="TG 510"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Large PTT Area -->
        <LinearLayout
            android:id="@+id/layoutPttButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnPtt"
                android:layout_width="260dp"
                android:layout_height="100dp"
                android:background="#059669"
                android:text="TEKAN UNTUK BICARA\n(HOLD PTT)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHardwarePttBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:background="#0F172A"
                android:gravity="center"
                android:padding="16dp"
                android:text="TOMBOL PTT LAYAR DISEMBUNYIKAN\nGunakan Tombol Fisik PTT Samping untuk Berbicara"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
