# ==============================================================================
# NinjaRadio Environment Configuration Example
# ==============================================================================

# Domain Configuration (Set to your domain or VPS IP + .sslip.io)
# Example: 128.199.200.10.sslip.io or radio.myclub.org or localhost
DOMAIN=localhost

# Server Identity & DMR ID
SERVER_CALLSIGN=N1NJA
SERVER_DMR_ID=5109999
DEFAULT_TALKGROUP=510

# Mumble (Murmur) SuperUser Password
MUMBLE_SUPERUSER_PASSWORD=ninjaradio_admin

# DMR Master & USRP Ports
DMR_MASTER_PORT=62031
OPENBRIDGE_PORT=62030
USRP_AUDIO_PORT=12345
MUMBLE_PORT=64738
