<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ninja SvxLink (HT Gateway)"
            android:textColor="#4FC3F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCONNECTED"
            android:textColor="#FF8A65"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SvxReflector Server Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:hint="Host / IP Reflector"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#667788"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Port"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#667788"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCallsign"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Callsign"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#667788"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Password / Auth Key"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#667788"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etTg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="TG"
            android:inputType="number"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#667788"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTg"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Set TG"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:text="Connect"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- HT Analog Gateway Panel (Baud, COS, Jalur Audio) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#161F28"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENGATURAN HT ANALOG GATEWAY"
            android:textColor="#81D4FA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Row 1: Jalur Audio & Baud Rate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jalur Audio:"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spAudioRoute"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="#202B36" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Baud Rate:"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spBaudRate"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="#202B36" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Mode PTT Out & Mode COS In -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mode PTT (Ke HT):"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spPttMode"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="#202B36" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mode COS (Dari HT):"
                    android:textColor="#B0BEC5"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spCosMode"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="#202B36" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 3: USB Device Scan & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvUsbStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="USB: Tidak Terhubung"
                android:textColor="#FFCC80"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnConnectUsb"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Hubungkan USB"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Indicators: Talker, COS, PTT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCosIndicator"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="#212121"
            android:gravity="center"
            android:text="COS: IDLE"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPttIndicator"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#212121"
            android:gravity="center"
            android:text="HT PTT: OFF"
            android:textColor="#757575"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Talker Display -->
    <TextView
        android:id="@+id/tvTalker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1C252E"
        android:gravity="center"
        android:padding="8dp"
        android:text="—"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Connected Nodes -->
    <TextView
        android:id="@+id/tvNodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:text="Nodes: -"
        android:textColor="#90A4AE"
        android:textSize="11sp" />

    <!-- Activity Log -->
    <ScrollView
        android:id="@+id/svLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="#0A0D10">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:textColor="#A5D6A7"
            android:textSize="10sp" />
    </ScrollView>

    <!-- VU Level & Manual Screen PTT -->
    <ProgressBar
        android:id="@+id/pbLevel"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="4dp"
        android:max="100" />

    <Button
        android:id="@+id/btnPtt"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#37474F"
        android:text="MANUAL PTT (Tahan)"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
