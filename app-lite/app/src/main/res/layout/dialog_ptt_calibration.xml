<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_lcd"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="3dp"
        android:paddingBottom="4dp">

        <!-- Header Row with Title + Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ SET TOMBOL PTT &amp; CH"
                android:textColor="@color/ninja_amber"
                android:textSize="10sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTopCloseCalib"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:text="✕"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_ptt"
                android:focusable="true"
                android:nextFocusDown="@+id/btnTargetPtt" />
        </LinearLayout>

        <!-- Target Selector Buttons: PTT | CH+ | CH- -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <Button
                android:id="@+id/btnTargetPtt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="1. PTT"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/ninja_red"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:layout_marginEnd="1dp"
                android:nextFocusDown="@+id/btnSaveLearnedKey"
                android:nextFocusRight="@+id/btnTargetChNext" />

            <Button
                android:id="@+id/btnTargetChNext"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:text="2. CH+ (NEXT)"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/ninja_cyan"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:nextFocusDown="@+id/btnSaveLearnedKey"
                android:nextFocusLeft="@+id/btnTargetPtt"
                android:nextFocusRight="@+id/btnTargetChPrev" />

            <Button
                android:id="@+id/btnTargetChPrev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:text="3. CH- (PREV)"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/ninja_amber"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:layout_marginStart="1dp"
                android:nextFocusDown="@+id/btnSaveLearnedKey"
                android:nextFocusLeft="@+id/btnTargetChNext"
                android:nextFocusRight="@+id/btnSaveLearnedKey" />
        </LinearLayout>

        <!-- Compact Current Mapping Summary -->
        <TextView
            android:id="@+id/tvCurrentPttSetting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PTT: Auto | CH+: Default | CH-: Default"
            android:textColor="@color/ninja_cyan"
            android:textSize="8sp"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <!-- Detection Status Box -->
        <TextView
            android:id="@+id/tvPttDetectStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:text="Tekan tombol fisik atau putar knob..."
            android:textColor="@color/ninja_text_primary"
            android:textSize="9sp"
            android:fontFamily="sans-serif-condensed"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/item_focus"
            android:padding="2dp"
            android:layout_marginBottom="2dp" />

        <!-- Quick Preset Row for Channel Keys -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <Button
                android:id="@+id/btnPresetKnob"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="KNOB (166/167)"
                android:textSize="8sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/ninja_cyan"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:layout_marginEnd="1dp"
                android:nextFocusUp="@+id/btnTargetPtt"
                android:nextFocusDown="@+id/btnSaveLearnedKey"
                android:nextFocusRight="@+id/btnPresetVol" />

            <Button
                android:id="@+id/btnPresetVol"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="VOLUME (+/-)"
                android:textSize="8sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/ninja_amber"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:nextFocusUp="@+id/btnTargetChNext"
                android:nextFocusDown="@+id/btnSaveLearnedKey"
                android:nextFocusLeft="@+id/btnPresetKnob"
                android:nextFocusRight="@+id/btnPresetPage" />

            <Button
                android:id="@+id/btnPresetPage"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="PAGE UP/DN (92/93)"
                android:textSize="8sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:layout_marginStart="1dp"
                android:nextFocusUp="@+id/btnTargetChPrev"
                android:nextFocusDown="@+id/btnSaveLearnedKey"
                android:nextFocusLeft="@+id/btnPresetVol" />
        </LinearLayout>

        <!-- Roomy Bottom Action Row: SIMPAN | RESET | KEMBALI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp">

            <Button
                android:id="@+id/btnSaveLearnedKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="SIMPAN"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/ninja_green"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:enabled="true"
                android:layout_marginEnd="1dp"
                android:nextFocusUp="@+id/btnTargetPtt"
                android:nextFocusRight="@+id/btnResetPttDefault" />

            <Button
                android:id="@+id/btnResetPttDefault"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="RESET"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/ninja_amber"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:nextFocusUp="@+id/btnTargetChNext"
                android:nextFocusLeft="@+id/btnSaveLearnedKey"
                android:nextFocusRight="@+id/btnCancelPttCalib" />

            <Button
                android:id="@+id/btnCancelPttCalib"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:text="KEMBALI"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_dpad"
                android:focusable="true"
                android:layout_marginStart="1dp"
                android:nextFocusUp="@+id/btnTargetChPrev"
                android:nextFocusLeft="@+id/btnResetPttDefault" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>