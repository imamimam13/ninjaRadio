<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_lcd"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Header Row with Title + Instant Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvTgDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ PILIH TALKGROUP"
                android:textColor="@color/ninja_amber"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTgDialogClose"
                android:layout_width="55dp"
                android:layout_height="match_parent"
                android:text="✕ BATAL"
                android:textSize="10sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/btn_ptt"
                android:focusable="true" />
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3300F0FF"
            android:layout_marginBottom="6dp" />

        <!-- Dynamic Container for TG list items -->
        <LinearLayout
            android:id="@+id/layoutTgItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
