<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ninja_btn_focused" />
            <stroke android:width="2dp" android:color="@color/ninja_cyan" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ninja_panel_raised" />
            <stroke android:width="1.5dp" android:color="@color/ninja_amber" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ninja_panel" />
            <stroke android:width="1dp" android:color="@color/ninja_panel_edge" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
