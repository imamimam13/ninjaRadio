<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Crimson TX Glow Bezel -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2C0E1C"
                android:centerColor="#1A1125"
                android:endColor="#110814" />
            <stroke android:width="2dp" android:color="#F43F5E" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#55F43F5E" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
