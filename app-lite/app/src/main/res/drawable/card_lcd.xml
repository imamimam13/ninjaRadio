<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Bezel Shadow / Edge -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0A1324"
                android:centerColor="#0F1C36"
                android:endColor="#080E1C" />
            <stroke android:width="1.5dp" android:color="#2A436E" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Subtle Top Glass Highlight -->
    <item android:top="1.5dp" android:left="4dp" android:right="4dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="#2238BDF8" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
